{
  "name": "nostos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NOSTOS — survival-RPG prototype",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "node src/sim/simulate.ts",
    "smoke": "npm run build && node tests/smoke.mjs",
    "smoke:dev": "node tests/build-dev.mjs && node tests/smoke-dev.mjs .devsmoke",
    "play": "node tools/play.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
